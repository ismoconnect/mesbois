rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // FONCTIONS D'AIDE (HELPERS)
    // ========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // ========================================================
    // 1. ADMINISTRATEURS
    // ========================================================
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ========================================================
    // 2. UTILISATEURS / PROFILS CLIENTS
    // ========================================================
    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================================
    // 3. CATALOGUE PRODUITS
    // ========================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================
    // 4. COMMANDES (ORDERS) - ACHATS CLIENTS ET INVITÉS
    // ========================================================
    match /orders/{orderId} {
      // Création ouverte à tous (résout le blocage de validation invité)
      allow create: if true;

      // Lecture par le propriétaire, l'admin ou consultation de suivi
      allow read: if isOwner(resource.data.userId) 
                  || isAdmin() 
                  || (resource.data.userId is string && resource.data.userId.matches('^guest_.*'))
                  || !isSignedIn();

      // Mise à jour (changement de statut, suivi transporteur)
      allow update: if isAdmin() 
                    || (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId);

      allow delete: if isAdmin();
    }

    // ========================================================
    // 5. AVIS CLIENTS (REVIEWS)
    // ========================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ========================================================
    // 6. CODES PROMO & PARAMÈTRES
    // ========================================================
    match /settings/coupons/items/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================
    // 7. COORDONNÉES RIB & PAYPAL
    // ========================================================
    match /rib/{docId} {
      // Lecture publique autorisée pour vérifier si le RIB est activé ou masquer
      allow read: if true;
      allow write: if isAdmin();
    }

    match /paypal/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================
    // 8. PANIERS
    // ========================================================
    match /carts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ========================================================
    // 9. PROTECTION PAR DÉFAUT
    // ========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}